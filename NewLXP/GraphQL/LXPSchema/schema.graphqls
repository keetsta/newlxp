type User {
  archivedRelations: UserArchivedRelations!
  assignedGroups_v2(isArchived: Boolean, organizationId: UUID): [UserAssignedLearningGroup!]!
  assignedOrganizations: [UserAssignedOrganization!]!
  assignedSpecialties: [UserAssignedSpecialty!]!
  assignedSuborganizations: [UserAssignedSuborganization!]!

  """User avatar URL"""
  avatar: String
  children: [StudentParent!]!
  createdAt: DateTime!
  curators: [Curator!]

  """User description"""
  description: String

  """User email"""
  email: String!

  """User first name"""
  firstName: String
  id: ID!
  isActivatedAccount: Boolean!

  """Is user personal data must be depersonalized"""
  isDepersonalized: Boolean!
  isFullDeactivated(organizationId: UUID): Boolean!

  """User is admin of the demo organization"""
  isLead: Boolean!
  isSuperAdmin: Boolean!

  """User last name"""
  lastName: String
  legalDocumentsApprovedAt: DateTime

  """User middle name"""
  middleName: String
  notificationsCount(isRead: Boolean): Int!
  notificationsSettings: NotificationsSettings!
  parents: [User!]! @deprecated(reason: "Используйте parents_V2")
  parents_V2: [StudentParent!]!

  """User phone number"""
  phoneNumber: String
  roles(organizationId: UUID, suborganizationId: UUID): [Identity_RoleType!]!
  student: Student
  teacher: Teacher
  updatedAt: DateTime!
}

type UserArchivedRelations {
  hasArchivedDiscipline: Boolean!
  userId: UUID!
}

type UserAssignedLearningGroup {
  learningGroup: LearningGroup!
  learningGroupId: UUID!
  roles: [Identity_RoleType!]!
  userId: UUID!
}

type UserAssignedOrganization {
  isDeactivated: Boolean!
  organization: organization_management_Organization! @deprecated(reason: "Используйте organization_V2")
  organizationId: ID!
  organization_V2: Organization!
  roles: [Identity_RoleType!]!
  userId: String!
}

input UserAssignedOrganizationsInputType {
  userId: UUID!
}

type UserAssignedSpecialty {
  isDeactivated: Boolean!
  roles: [Identity_RoleType!]!
  specialty: Specialty!
  specialtyId: UUID!
  userId: UUID!
}

type UserAssignedSuborganization {
  isDeactivated: Boolean!
  roles: [Identity_RoleType!]!
  suborganization: Suborganization!
  suborganizationId: ID!
  userId: String!
}

type UserInOrganization {
  isActive: Boolean!
  roles: [Identity_RoleType!]!
  user: User!
}

