  averageStudentScore: Float @deprecated(reason: "больше не используется")
  endDate: DateTime!
  id: UUID!
  isReadyToRemoveCreateChildLearningGroupsBanner: Boolean! @deprecated(reason: "Больше не используется. Возвращает мок данные (всегда true)")
