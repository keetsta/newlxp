type TaskDisciplineTopicContentBlock {
  body: String!
  canBeSentAfterDeadline: Boolean! @deprecated(reason: "Возможность отправлять задания после дедлайна теперь задается на уровне группы. Этот поле не актуально")
  competencies: [Competencies!]!
  customStudentDeadline(studentId: UUID): StudentContentBlockCustomDeadline
  deadlineDate: DateTime @deprecated(reason: "Дедлайн теперь задается на уровне группы. Этот дедлайн не актуален")
  hasActivity: Boolean!
  hasSoloStudents: Boolean!
  id: UUID!
  isConnectedWithCompetence: Boolean!
  kind: DisciplineTopicContentBlockKind!
  learningGroups(learningGroupId: UUID): [LearningGroupContentBlock!]!
  maxScore: Float
  name: String!
  order: Float!
  originalBlockId: UUID

  """
  Счетчик непросмотренных ответов по заданиям в теме студентов "Вне группы".
  """
  soloStudentsUnviewedAnswers(disciplineId: UUID): Float
  statistics: TaskDisciplineTopicContentBlockStatistics!

  """
  Поле опциональное! Если не передать studentId, nо всегда будет возвращаться null. Название немного конфузит, но поле вычисляется так: берется дедлайн для студента по заданию и смотрим прошел ли этот дедлайн. Статус темы не учитывается
